@model FinTrack.Web.ViewModels.Accounts.CreateAccountViewModel
@using FinTrack.Domain.Common
@using FinTrack.Domain.Enums
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "New account";
    ViewData["Subtitle"] = "Add a wallet, bank account or e-wallet to track";
    ViewData["HideNewTransaction"] = true;
}

<div class="ft-form-page">
    <form asp-action="Create" method="post" class="ft-card ft-form-card">

        <div asp-validation-summary="ModelOnly"></div>

        <div class="ft-form-grid">
            <div class="ft-field ft-field-full">
                <label asp-for="Name">Account name</label>
                <input asp-for="Name" class="ft-input" placeholder="e.g. Main wallet" autocomplete="off" />
                <span asp-validation-for="Name"></span>
            </div>

            <div class="ft-field">
                <label asp-for="Type">Account type</label>
                <select asp-for="Type"
                        asp-items="Html.GetEnumSelectList<AccountType>()"
                        class="ft-select"></select>
                <span asp-validation-for="Type"></span>
            </div>

            <div class="ft-field">
                <label asp-for="Currency">Currency</label>
                <select asp-for="Currency"
                        asp-items="@(new SelectList(Currencies.Supported))"
                        class="ft-select"
                        data-currency-source></select>
                <span asp-validation-for="Currency"></span>
            </div>

            <div class="ft-field ft-field-full">
                <label asp-for="OpeningBalance">Opening balance</label>
                <div class="ft-input-group">
                    <input asp-for="OpeningBalance" type="number" step="0.01" class="ft-input ft-num" />
                    <span class="ft-input-suffix" data-currency-label>@Model.Currency</span>
                </div>
                <span asp-validation-for="OpeningBalance"></span>
            </div>

            <p class="ft-hint ft-field-full">
                The opening balance is the amount in the account today. Negative balances are allowed.
                The currency can be changed later only while the account has no transactions or transfers.
            </p>
        </div>

        <div class="ft-form-actions">
            <button type="submit" class="ft-btn ft-btn-primary">Create account</button>
            <a asp-action="Index" class="ft-btn ft-btn-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
