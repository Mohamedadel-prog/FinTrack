@model IReadOnlyList<FinTrack.Application.Accounts.DTOs.AccountDto>
@using FinTrack.Domain.Enums
@using System.Globalization

@{
    ViewData["Title"] = "My accounts";
    ViewData["Subtitle"] = "Wallets, bank accounts and their balances";

    // Balances in different currencies can't be added together
    var totalsByCurrency = Model
        .GroupBy(a => a.Currency)
        .Select(g => (Currency: g.Key, Total: g.Sum(a => a.CurrentBalance), Count: g.Count()))
        .OrderByDescending(x => x.Count)
        .ThenBy(x => x.Currency)
        .ToList();

    if (totalsByCurrency.Count == 0)
    {
        totalsByCurrency.Add((FinTrack.Domain.Common.Currencies.Default, 0m, 0));
    }

    var archivedCount = ViewData["ArchivedCount"] as int? ?? 0;
}

@if (TempData["SuccessMessage"] is string message)
{
    <div class="ft-alert ft-alert-success" role="status">@message</div>
}

<section class="ft-stat-grid" aria-label="Summary">
    @foreach (var total in totalsByCurrency)
    {
        <div class="ft-card ft-stat">
            <span class="ft-label">Total balance · @total.Currency</span>
            <span class="ft-num ft-stat-value @(total.Total < 0 ? "ft-danger-text" : "")" data-count="@total.Total.ToString(CultureInfo.InvariantCulture)">@total.Total.ToString("N2")</span>
            <span class="ft-stat-foot">@total.Currency · combined across @total.Count active @(total.Count == 1 ? "account" : "accounts")</span>
        </div>
    }
    <div class="ft-card ft-stat">
        <span class="ft-label">Active accounts</span>
        <span class="ft-num ft-stat-value" data-count="@Model.Count" data-decimals="0">@Model.Count</span>
        <span class="ft-stat-foot">
            @if (archivedCount > 0)
            {
                <a asp-action="Archived">@archivedCount archived @(archivedCount == 1 ? "account" : "accounts")</a>
            }
            else
            {
                <text>No archived accounts</text>
            }
        </span>
    </div>
</section>

<div class="ft-page-head">
    <h2 style="font-size:16px;font-weight:700">Your accounts</h2>
    <div class="ft-actions">
        @if (archivedCount > 0)
        {
            <a asp-action="Archived" class="ft-btn ft-btn-ghost ft-btn-sm">Archived (@archivedCount)</a>
        }
        <a asp-controller="Transfers" asp-action="Create" class="ft-btn ft-btn-ghost ft-btn-sm">Transfer money</a>
        <a asp-action="Create" class="ft-btn ft-btn-ghost ft-btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            Add account
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="ft-card ft-empty">
        <div class="ft-empty-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h13v4" /><path d="M3 7v11a2 2 0 0 0 2 2h15V9H5a2 2 0 0 1-2-2z" /><circle cx="16" cy="14.5" r="1.2" /></svg>
        </div>
        <h3>No accounts yet</h3>
        <p>Create your first account — cash, bank or e-wallet — to start tracking your money.</p>
        <a asp-action="Create" class="ft-btn ft-btn-primary">Create your first account</a>
    </div>
}
else
{
    <div class="ft-account-grid">
        @foreach (var account in Model)
        {
            var typeLabel = account.Type switch
            {
                AccountType.Cash => "Cash",
                AccountType.Bank => "Bank account",
                AccountType.EWallet => "E-wallet",
                _ => account.Type.ToString()
            };

            <article class="ft-card ft-account">
                <div class="ft-account-top">
                    <span class="ft-account-icon" aria-hidden="true">
                        @switch (account.Type)
                        {
                            case AccountType.Bank:
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10 12 4l9 6" /><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8" /><path d="M3 20h18" /></svg>
                                break;
                            case AccountType.EWallet:
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M11 18h2" /></svg>
                                break;
                            default:
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2" /><circle cx="12" cy="12" r="2.5" /><path d="M6 12h.01M18 12h.01" /></svg>
                                break;
                        }
                    </span>
                    <div style="flex:1;min-width:0">
                        <h3 class="ft-account-name">@account.Name</h3>
                        <span class="ft-account-type">@typeLabel · @account.Currency</span>
                    </div>
                    <div class="ft-actions">
                        <a asp-action="Edit"
                           asp-route-id="@account.Id"
                           class="ft-icon-btn"
                           aria-label="Edit @account.Name"
                           title="Edit">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4Z" /></svg>
                        </a>
                        <form asp-action="Archive"
                              asp-route-id="@account.Id"
                              method="post"
                              class="ft-inline-form"
                              onsubmit="return confirm('Archive this account? Its transactions will be hidden until you restore it.');">
                            <button type="submit"
                                    class="ft-icon-btn is-danger"
                                    aria-label="Archive @account.Name"
                                    title="Archive">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="5" rx="1" /><path d="M5 8v11a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8" /><path d="M10 12h4" /></svg>
                            </button>
                        </form>
                    </div>
                </div>

                <div>
                    <span class="ft-label">Current balance</span>
                    <div class="ft-num ft-account-balance @(account.CurrentBalance < 0 ? "ft-danger-text" : "")"
                         data-count="@account.CurrentBalance.ToString(CultureInfo.InvariantCulture)">
                        @account.CurrentBalance.ToString("N2")
                    </div>
                </div>

                <div class="ft-account-meta">
                    <span>Opening balance</span>
                    <span class="ft-num">@account.OpeningBalance.ToString("N2")</span>
                </div>
            </article>
        }
    </div>
}
