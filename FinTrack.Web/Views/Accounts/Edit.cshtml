@model FinTrack.Web.ViewModels.Accounts.EditAccountViewModel
@using FinTrack.Domain.Common
@using FinTrack.Domain.Enums
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit account";
    ViewData["Subtitle"] = "Rename the account, or change its type or currency";
    ViewData["HideNewTransaction"] = true;
}

<div class="ft-form-page">
    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          class="ft-card ft-form-card">

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly"></div>

        <div class="ft-form-grid">
            <div class="ft-field">
                <label asp-for="Name">Account name</label>
                <input asp-for="Name" class="ft-input" autocomplete="off" />
                <span asp-validation-for="Name"></span>
            </div>

            <div class="ft-field">
                <label asp-for="Type">Account type</label>
                <select asp-for="Type"
                        asp-items="Html.GetEnumSelectList<AccountType>()"
                        class="ft-select"></select>
                <span asp-validation-for="Type"></span>
            </div>

            <div class="ft-field">
                <label asp-for="Currency">Currency</label>
                <select asp-for="Currency"
                        asp-items="@(new SelectList(Currencies.Supported))"
                        class="ft-select"></select>
                <span asp-validation-for="Currency"></span>
            </div>
        </div>

        <div class="ft-alert ft-alert-info">
            The opening balance can't be edited. The current balance is calculated from your transactions and transfers.
            The currency can only be changed while the account has no transactions or transfers.
        </div>

        <div class="ft-form-actions">
            <button type="submit" class="ft-btn ft-btn-primary">Save changes</button>
            <a asp-action="Index" class="ft-btn ft-btn-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
