@model FinTrack.Web.ViewModels.Accounts.EditAccountViewModel
@using FinTrack.Domain.Enums

@{
    ViewData["Title"] = "Edit Account";
}

<div class="ft-form-page">

    <div class="ft-form-header">
        <span class="ft-eyebrow">ACCOUNTS MANAGEMENT</span>
        <h1>Edit Account</h1>
        <p>Update your financial account information.</p>
    </div>

    <div class="ft-form-card">

        <h2 class="ft-form-section-title">
            Account Details
        </h2>

        <form asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="ft-field">
                <label asp-for="Name"
                       class="form-label">
                    Account Name
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="ft-field">
                <label asp-for="Type"
                       class="form-label">
                    Account Type
                </label>

                <select asp-for="Type"
                        asp-items="Html.GetEnumSelectList<AccountType>()"
                        class="form-select">
                </select>

                <span asp-validation-for="Type"
                      class="text-danger"></span>
            </div>

            <div class="alert alert-info">
                Opening Balance cannot be edited from this page.
                Your current balance is calculated automatically
                from your transactions.
            </div>

            <div class="ft-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn ft-btn-cancel">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
