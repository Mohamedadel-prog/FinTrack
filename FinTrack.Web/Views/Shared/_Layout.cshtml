@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var controller = ViewContext.RouteData.Values["controller"]?
        .ToString() ?? "";

    string Active(string name) =>
        controller.Equals(name, StringComparison.OrdinalIgnoreCase)
            ? "is-active"
            : "";

    string? Current(string name) =>
        controller.Equals(name, StringComparison.OrdinalIgnoreCase)
            ? "page"
            : null;

    var userName = User.Identity?.Name ?? "";
    var fullName = User.FindFirst(FinTrack.Infrastructure.Identity.FinTrackClaimTypes.FullName)?.Value;
    var displayName = string.IsNullOrWhiteSpace(fullName) ? userName : fullName;
    var initials = string.Concat(
        displayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0]));
    if (string.IsNullOrEmpty(initials)) { initials = "?"; }
    var subtitle = ViewData["Subtitle"] as string;
    var hideTopbarAction = ViewData["HideNewTransaction"] is true;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B0E13" />

    <script>
        // Enable entrance animations only when JS runs and the user hasn't asked for reduced motion
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.documentElement.classList.add("ft-anim");
        }
    </script>

    <title>@ViewData["Title"] | FinTrack</title>

    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FinTrack.Web.styles.css" asp-append-version="true" />
</head>

<body>

    @if (isAuthenticated)
    {
        <div class="ft-app">

            <aside class="ft-rail">
                <a class="ft-logo"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="FinTrack home">F</a>

                <nav class="ft-rail-nav" aria-label="Main">
                    <a class="ft-rail-link @Active("Home")"
                       asp-controller="Home"
                       asp-action="Index"
                       aria-current="@Current("Home")"
                       aria-label="Dashboard"
                       data-tip="Dashboard">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
                    </a>

                    <a class="ft-rail-link @Active("Accounts")"
                       asp-controller="Accounts"
                       asp-action="Index"
                       aria-current="@Current("Accounts")"
                       aria-label="My accounts"
                       data-tip="My accounts">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h13v4" /><path d="M3 7v11a2 2 0 0 0 2 2h15V9H5a2 2 0 0 1-2-2z" /><circle cx="16" cy="14.5" r="1.2" /></svg>
                    </a>

                    <a class="ft-rail-link @Active("Transactions")"
                       asp-controller="Transactions"
                       asp-action="Index"
                       aria-current="@Current("Transactions")"
                       aria-label="Transactions"
                       data-tip="Transactions">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4 3 8l4 4" /><path d="M3 8h14" /><path d="m17 20 4-4-4-4" /><path d="M21 16H7" /></svg>
                    </a>

                    <a class="ft-rail-link @Active("Transfers")"
                       asp-controller="Transfers"
                       asp-action="Index"
                       aria-current="@Current("Transfers")"
                       aria-label="Transfers"
                       data-tip="Transfers">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m17 2 4 4-4 4" /><path d="M3 11v-1a4 4 0 0 1 4-4h14" /><path d="m7 22-4-4 4-4" /><path d="M21 13v1a4 4 0 0 1-4 4H3" /></svg>
                    </a>

                    <a class="ft-rail-link @Active("Categories")"
                       asp-controller="Categories"
                       asp-action="Index"
                       aria-current="@Current("Categories")"
                       aria-label="Categories"
                       data-tip="Categories">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z" /><circle cx="8" cy="8" r="1.5" /></svg>
                    </a>
                </nav>

                <form class="ft-rail-bottom"
                      asp-controller="Auth"
                      asp-action="Logout"
                      method="post">
                    <button type="submit"
                            class="ft-rail-logout"
                            aria-label="Log out"
                            data-tip="Log out">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5" /><path d="M21 12H9" /></svg>
                    </button>
                </form>
            </aside>

            <div class="ft-main">

                <header class="ft-topbar">
                    @if (IsSectionDefined("PageHeader"))
                    {
                        @await RenderSectionAsync("PageHeader")
                    }
                    else
                    {
                        <div class="ft-topbar-title">
                            <h1>@ViewData["Title"]</h1>
                            @if (!string.IsNullOrEmpty(subtitle))
                            {
                                <span>@subtitle</span>
                            }
                        </div>
                    }

                    <div class="ft-topbar-actions">
                        @if (!hideTopbarAction)
                        {
                            <a asp-controller="Transactions"
                               asp-action="Create"
                               class="ft-btn ft-btn-primary"
                               aria-label="New transaction">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                                <span>New transaction</span>
                            </a>
                        }

                        <span class="ft-avatar" title="@displayName · @userName">@initials</span>
                    </div>
                </header>

                <main class="ft-content">
                    @RenderBody()
                </main>

                <footer class="ft-footer">
                    <span>© @DateTime.UtcNow.Year FinTrack</span>
                    <span>Personal finance, organized.</span>
                </footer>
            </div>
        </div>
    }
    else
    {
        if (IsSectionDefined("PageHeader"))
        {
            IgnoreSection("PageHeader");
        }

        <div class="ft-public">
            <header class="ft-public-header">
                <a class="ft-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="ft-logo">F</span>
                    FinTrack
                </a>

                @if (controller.Equals("Auth", StringComparison.OrdinalIgnoreCase)
                     && ViewContext.RouteData.Values["action"]?.ToString() == "Login")
                {
                    <a asp-controller="Auth" asp-action="Register" class="ft-btn ft-btn-ghost ft-btn-sm">Create account</a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="ft-btn ft-btn-ghost ft-btn-sm">Sign in</a>
                }
            </header>

            <main class="ft-public-main">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
