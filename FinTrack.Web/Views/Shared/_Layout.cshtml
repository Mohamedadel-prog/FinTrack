
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var controller = ViewContext.RouteData.Values["controller"]?
        .ToString() ?? "";

    string Active(string name) =>
        controller.Equals(name, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon"
      type="image/png"
      href="~/favicon.png"
      asp-append-version="true" />
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | FinTrack</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/FinTrack.Web.styles.css"
          asp-append-version="true" />
</head>

<body class="ft-body">

    @if (isAuthenticated)
    {
        <!-- Sidebar -->
        <aside class="ft-sidebar collapse" id="finSidebar">

            <a class="ft-brand"
               asp-controller="Home"
               asp-action="Index">
                <span class="ft-brand-mark">F</span>
                <span>FinTrack<span class="ft-brand-dot">.</span></span>
            </a>

            <div class="ft-sidebar-label">WORKSPACE</div>

            <nav class="ft-navigation">

                <a class="ft-nav-link @Active("Home")"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="ft-nav-icon">▦</span>
                    Dashboard
                </a>

                <a class="ft-nav-link @Active("Accounts")"
                   asp-controller="Accounts"
                   asp-action="Index">
                    <span class="ft-nav-icon">▣</span>
                    My Accounts
                </a>

                <a class="ft-nav-link @Active("Transactions")"
                   asp-controller="Transactions"
                   asp-action="Index">
                    <span class="ft-nav-icon">⇄</span>
                    Transactions
                </a>

                <a class="ft-nav-link @Active("Categories")"
                   asp-controller="Categories"
                   asp-action="Index">
                    <span class="ft-nav-icon">▤</span>
                    Categories
                </a>

            </nav>

            <div class="ft-sidebar-bottom">
                <div class="ft-account-label">SIGNED IN AS</div>

                <div class="ft-account-email"
                     title="@User.Identity?.Name">
                    @User.Identity?.Name
                </div>

                <form asp-controller="Auth"
                      asp-action="Logout"
                      method="post">

                    <button type="submit"
                            class="ft-logout">
                        Log out
                    </button>
                </form>
            </div>
        </aside>
    }

    <div class="@(isAuthenticated ? "ft-main" : "ft-public-main")">

        @if (isAuthenticated)
        {
            <!-- Topbar -->
            <header class="ft-topbar">

                <div class="d-flex align-items-center gap-3">
                    <button class="ft-menu-toggle"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#finSidebar"
                            aria-controls="finSidebar"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        ☰
                    </button>

                    <div>
                        <span class="ft-topbar-label">FINTRACK WORKSPACE</span>

                        <h5 class="ft-topbar-title mb-0">
                            @ViewData["Title"]
                        </h5>
                    </div>
                </div>

                <div class="ft-topbar-actions">
                    <a asp-controller="Transactions"
                       asp-action="Create"
                       class="btn btn-primary">
                        + New Transaction
                    </a>
                </div>

            </header>
        }
        else
        {
            <header class="ft-public-header">
                <a class="ft-public-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    FinTrack<span>.</span>
                </a>

                <div class="d-flex gap-2">
                    <a asp-controller="Auth"
                       asp-action="Login"
                       class="btn btn-outline-primary">
                        Login
                    </a>

                    <a asp-controller="Auth"
                       asp-action="Register"
                       class="btn btn-primary">
                        Get Started
                    </a>
                </div>
            </header>
        }

        <!-- Page Content -->
        <main class="ft-content">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="ft-footer">
            <span>© @DateTime.UtcNow.Year FinTrack</span>
            <span>Personal Finance Management</span>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
