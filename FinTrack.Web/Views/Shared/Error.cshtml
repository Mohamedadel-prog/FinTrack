@model ErrorViewModel

@{
    ViewData["Title"] = "Something went wrong";
}

<div class="ft-state">
    <div class="ft-empty-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4" /><path d="M12 17h.01" /><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
    </div>
    <h1>Something went wrong</h1>
    <p>We couldn't complete your request. Please try again in a moment.</p>

    @if (Model.ShowRequestId)
    {
        <p>Request ID: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="ft-btn ft-btn-primary">Back to dashboard</a>
</div>
