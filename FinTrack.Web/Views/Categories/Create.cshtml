@model FinTrack.Web.ViewModels.Categories.CreateCategoryViewModel
@using FinTrack.Domain.Enums

@{
    ViewData["Title"] = "Create Category";
}

<div class="ft-form-page">

    <div class="ft-form-header">
        <span class="ft-eyebrow">CATEGORIES MANAGEMENT</span>
        <h1>Create Category</h1>
        <p>Organize your income and expenses.</p>
    </div>

    <div class="ft-form-card">

        <h2 class="ft-form-section-title">
            Category Information
        </h2>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="ft-field">
                <label asp-for="Name"
                       class="form-label">
                    Category Name
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="e.g. Food, Salary, Transport" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="ft-field">
                <label asp-for="Type"
                       class="form-label">
                    Category Type
                </label>

                <select asp-for="Type"
                        asp-items="Html.GetEnumSelectList<CategoryType>()"
                        class="form-select">
                </select>

                <span asp-validation-for="Type"
                      class="text-danger"></span>
            </div>

            <div class="ft-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    Create Category
                </button>

                <a asp-action="Index"
                   class="btn ft-btn-cancel">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
