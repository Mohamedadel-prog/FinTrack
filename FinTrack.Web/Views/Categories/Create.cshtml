@model FinTrack.Web.ViewModels.Categories.CreateCategoryViewModel
@using FinTrack.Domain.Enums

@{
    ViewData["Title"] = "New category";
    ViewData["Subtitle"] = "Use categories to group your income and expenses";
    ViewData["HideNewTransaction"] = true;
}

<div class="ft-form-page">
    <form asp-action="Create" method="post" class="ft-card ft-form-card">

        <div asp-validation-summary="ModelOnly"></div>

        <fieldset class="ft-field" style="border:0;margin:0;padding:0">
            <legend class="ft-field-label" style="margin-bottom:8px">Type</legend>
            <div class="ft-segmented">
                <input type="radio" asp-for="Type" value="@CategoryType.Expense" id="catExpense" />
                <label for="catExpense" class="is-expense">Expense</label>

                <input type="radio" asp-for="Type" value="@CategoryType.Income" id="catIncome" />
                <label for="catIncome" class="is-income">Income</label>
            </div>
            <span asp-validation-for="Type"></span>
        </fieldset>

        <div class="ft-field">
            <label asp-for="Name">Category name</label>
            <input asp-for="Name" class="ft-input" placeholder="e.g. Groceries, Salary, Transport" autocomplete="off" />
            <span asp-validation-for="Name"></span>
            <span class="ft-hint">The type can't be changed after the category is created.</span>
        </div>

        <div class="ft-form-actions">
            <button type="submit" class="ft-btn ft-btn-primary">Create category</button>
            <a asp-action="Index" class="ft-btn ft-btn-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
