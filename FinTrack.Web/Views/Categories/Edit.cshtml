@model FinTrack.Web.ViewModels.Categories.EditCategoryViewModel
@using FinTrack.Domain.Enums

@{
    ViewData["Title"] = "Rename category";
    ViewData["Subtitle"] = "The type stays the same after creation";
    ViewData["HideNewTransaction"] = true;

    var isIncome = Model.Type == CategoryType.Income;
}

<div class="ft-form-page">
    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          class="ft-card ft-form-card">

        <input asp-for="Id" type="hidden" />
        <input asp-for="Type" type="hidden" />

        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <span class="ft-pill @(isIncome ? "ft-pill-income" : "ft-pill-expense")">@(isIncome ? "Income" : "Expense") category</span>
        </div>

        <div class="ft-field">
            <label asp-for="Name">Category name</label>
            <input asp-for="Name" class="ft-input" autocomplete="off" />
            <span asp-validation-for="Name"></span>
        </div>

        <div class="ft-form-actions">
            <button type="submit" class="ft-btn ft-btn-primary">Save changes</button>
            <a asp-action="Index" class="ft-btn ft-btn-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
