@model FinTrack.Web.ViewModels.Categories.EditCategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="ft-form-page">

    <div class="ft-form-header">
        <span class="ft-eyebrow">CATEGORIES MANAGEMENT</span>
        <h1>Edit Category</h1>
        <p>Update your category information.</p>
    </div>

    <div class="ft-form-card">

        <h2 class="ft-form-section-title">
            Category Details
        </h2>

        <form asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="ft-field">
                <label asp-for="Name"
                       class="form-label">
                    Category Name
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="ft-field">
                <label class="form-label">
                    Category Type
                </label>

                <input value="@Model.Type"
                       class="form-control"
                       disabled />

                <p class="ft-field-hint">
                    Category type cannot be changed after creation.
                </p>
            </div>

            <div class="ft-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn ft-btn-cancel">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
