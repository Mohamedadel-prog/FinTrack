@model FinTrack.Web.ViewModels.Transactions.CreateTransactionViewModel
@using FinTrack.Domain.Enums

@{
    ViewData["Title"] = "Add Transaction";
}

<div class="ft-form-page">

    <h2>Add Transaction</h2>

    <p class="text-muted">
        Record your income or expense.
    </p>

    <div class="ft-form-card">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Type"
                           class="form-label"></label>

                    <select asp-for="Type"
                            asp-items="Html.GetEnumSelectList<TransactionType>()"
                            class="form-select"
                            id="transactionType">
                    </select>

                    <span asp-validation-for="Type"
                          class="text-danger"></span>
                </div>

                <div class="ft-field">
                    <label asp-for="AccountId"
                           class="form-label"></label>

                    <select asp-for="AccountId"
                            asp-items="Model.Accounts"
                            class="form-select">
                        <option value="0">Select account</option>
                    </select>

                    <span asp-validation-for="AccountId"
                          class="text-danger"></span>
                </div>

                <div class="ft-field">
                    <label asp-for="CategoryId"
                           class="form-label"></label>

                    <select asp-for="CategoryId"
                            asp-items="Model.Categories"
                            class="form-select"
                            id="categorySelect">
                        <option value="0">Select category</option>
                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger"></span>
                </div>

                <div class="ft-field">
                    <label asp-for="Amount"
                           class="form-label"></label>

                    <input asp-for="Amount"
                           type="number"
                           min="0.01"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="Amount"
                          class="text-danger"></span>
                </div>

                <div class="ft-field">
                    <label asp-for="TransactionDate"
                           class="form-label"></label>

                    <input asp-for="TransactionDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="TransactionDate"
                          class="text-danger"></span>
                </div>

                <div class="ft-field">
                    <label asp-for="Note"
                           class="form-label"></label>

                    <textarea asp-for="Note"
                              class="form-control"
                              rows="3"></textarea>

                    <span asp-validation-for="Note"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Transaction
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const typeSelect = document.getElementById("transactionType");
        const categorySelect = document.getElementById("categorySelect");

        typeSelect.addEventListener("change", async function () {
            categorySelect.replaceChildren(new Option("Loading...", "0"));
            categorySelect.disabled = true;

            try {
                const url = '@Url.Action("GetCategoriesByType", "Transactions")';
                const response = await fetch(
                    `${url}?type=${encodeURIComponent(typeSelect.value)}`
                );

                if (!response.ok) {
                    throw new Error("Unable to load categories");
                }

                const categories = await response.json();

                categorySelect.replaceChildren(
                    new Option("Select category", "0")
                );

                for (const category of categories) {
                    categorySelect.add(
                        new Option(category.name, category.id)
                    );
                }
            } catch {
                categorySelect.replaceChildren(
                    new Option("Could not load categories", "0")
                );
            } finally {
                categorySelect.disabled = false;
            }
        });
    </script>
}
