@model IReadOnlyList<FinTrack.Application.Transactions.DTOs.TransactionDto>
@using FinTrack.Domain.Enums

@{
    ViewData["Title"] = "Transactions";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Transactions</h2>

        <a asp-action="Create" class="btn btn-primary">
            + Add Transaction
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success">
            @message
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No transactions yet.
        </div>
    }
    else
    {
        <div class="ft-data-card">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table ft-data-table align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Account</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var transaction in Model)
                            {
                                <tr>
                                    <td>
                                        @transaction.TransactionDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>@transaction.AccountName</td>

                                    <td>@transaction.CategoryName</td>

                                    <td>
                                        @if (transaction.Type == TransactionType.Income)
                                        {
                                            <span class="badge bg-success">
                                                Income
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Expense
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="fw-bold @(transaction.Type == TransactionType.Income ? "text-success" : "text-danger")">
                                            @(transaction.Type == TransactionType.Income ? "+" : "-")
                                            @transaction.Amount.ToString("N2") EGP
                                        </span>
                                    </td>
                                    

                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@transaction.Id"
                                               class="btn btn-outline-primary btn-sm">
                                                Edit
                                            </a>
                                            <form asp-action="Delete"
                                                  asp-route-id="@transaction.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this transaction?');">
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    }
</div>
