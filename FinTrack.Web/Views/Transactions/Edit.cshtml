@model FinTrack.Web.ViewModels.Transactions.EditTransactionViewModel

@{
    ViewData["Title"] = "Edit Transaction";
}

<div class="ft-form-page">

    <h2>Edit Transaction</h2>

    <p class="text-muted">
        Update your transaction details.
    </p>

    <div class="ft-form-card">
        <div class="card-body">

            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="ft-field">
                    <label class="form-label">Account</label>

                    <input value="@Model.AccountName"
                           class="form-control"
                           disabled />
                </div>

                <div class="ft-field">
                    <label class="form-label">Transaction Type</label>

                    <input value="@Model.Type"
                           class="form-control"
                           disabled />
                </div>

                <div class="ft-field">
                    <label asp-for="CategoryId"
                           class="form-label">
                        Category
                    </label>

                    <select asp-for="CategoryId"
                            asp-items="Model.Categories"
                            class="form-select">
                        <option value="0">Select category</option>
                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger"></span>
                </div>

                <div class="ft-field">
                    <label asp-for="Amount"
                           class="form-label"></label>

                    <input asp-for="Amount"
                           class="form-control"
                           type="number"
                           min="0.01"
                           step="0.01" />

                    <span asp-validation-for="Amount"
                          class="text-danger"></span>
                </div>

                <div class="ft-field">
                    <label asp-for="TransactionDate"
                           class="form-label"></label>

                    <input asp-for="TransactionDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="TransactionDate"
                          class="text-danger"></span>
                </div>

                <div class="ft-field">
                    <label asp-for="Note"
                           class="form-label"></label>

                    <textarea asp-for="Note"
                              class="form-control"
                              rows="3"></textarea>

                    <span asp-validation-for="Note"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
