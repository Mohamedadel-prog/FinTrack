@{
    ViewData["Title"] = "Password reset";
}

<div class="ft-state">
    <div class="ft-empty-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
    </div>
    <h1>Password updated</h1>
    <p>Your password has been reset. Sign in with your new password.</p>
    <a asp-action="Login" class="ft-btn ft-btn-primary">Sign in</a>
</div>
