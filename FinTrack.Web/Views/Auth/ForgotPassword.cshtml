@model FinTrack.Web.ViewModels.Auth.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot password";
}

<div class="ft-auth">
    <partial name="_AuthAside" />

    <div class="ft-auth-form">
        <div style="display:flex;flex-direction:column;gap:6px">
            <h1>Forgot your password?</h1>
            <p class="ft-muted">Enter your email and we'll send you a link to choose a new one.</p>
        </div>

        <form asp-action="ForgotPassword" method="post" class="ft-auth-fields">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="ft-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="ft-input" autocomplete="email" placeholder="you@example.com" />
                <span asp-validation-for="Email"></span>
            </div>

            <button type="submit" class="ft-btn ft-btn-primary ft-btn-block">Send reset link</button>
        </form>

        <p class="ft-auth-switch">
            Remembered it?
            <a asp-action="Login">Back to sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
