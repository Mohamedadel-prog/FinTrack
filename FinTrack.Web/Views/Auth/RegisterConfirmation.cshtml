@{
    ViewData["Title"] = "Check your email";
    var email = ViewData["Email"] as string;
}

<div class="ft-state">
    <div class="ft-empty-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" /></svg>
    </div>
    <h1>Check your email</h1>
    <p>
        We sent a confirmation link to
        <strong>@(string.IsNullOrWhiteSpace(email) ? "your email address" : email)</strong>.
        Open it to activate your account, then sign in.
    </p>
    <a asp-action="Login" class="ft-btn ft-btn-primary">Go to sign in</a>
    <p class="ft-muted" style="font-size:14px">
        Didn't get it? Check your spam folder or
        <a asp-action="ResendConfirmation" asp-route-email="@email">send it again</a>.
    </p>
</div>
