@model FinTrack.Web.ViewModels.Auth.RegisterViewModel

@{
    ViewData["Title"] = "Create account";
}

<div class="ft-auth">
    <partial name="_AuthAside" />

    <div class="ft-auth-form">
        <div style="display:flex;flex-direction:column;gap:6px">
            <h1>Create your account</h1>
            <p class="ft-muted">It takes less than a minute.</p>
        </div>

        <form asp-controller="Auth"
              asp-action="Register"
              method="post"
              class="ft-auth-fields">

            <div asp-validation-summary="ModelOnly"></div>

            <div class="ft-field">
                <label asp-for="FullName">Full name</label>
                <input asp-for="FullName" class="ft-input" autocomplete="name" />
                <span asp-validation-for="FullName"></span>
            </div>

            <div class="ft-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="ft-input" autocomplete="email" placeholder="you@example.com" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="ft-field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" class="ft-input" autocomplete="new-password" />
                <span class="ft-hint">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</span>
                <span asp-validation-for="Password"></span>
            </div>

            <div class="ft-field">
                <label asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword" class="ft-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="ft-btn ft-btn-primary ft-btn-block">Create account</button>
        </form>

        <p class="ft-auth-switch">
            Already have an account?
            <a asp-controller="Auth" asp-action="Login">Sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
