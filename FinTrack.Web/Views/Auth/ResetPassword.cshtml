@model FinTrack.Web.ViewModels.Auth.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset password";
}

<div class="ft-auth">
    <partial name="_AuthAside" />

    <div class="ft-auth-form">
        <div style="display:flex;flex-direction:column;gap:6px">
            <h1>Choose a new password</h1>
            <p class="ft-muted">Pick something you haven't used for FinTrack before.</p>
        </div>

        <form asp-action="ResetPassword" method="post" class="ft-auth-fields">
            <div asp-validation-summary="ModelOnly"></div>

            <input asp-for="Code" type="hidden" />

            <div class="ft-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="ft-input" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="ft-field">
                <label asp-for="Password">New password</label>
                <input asp-for="Password" class="ft-input" autocomplete="new-password" />
                <span class="ft-hint">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</span>
                <span asp-validation-for="Password"></span>
            </div>

            <div class="ft-field">
                <label asp-for="ConfirmPassword">Confirm new password</label>
                <input asp-for="ConfirmPassword" class="ft-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="ft-btn ft-btn-primary ft-btn-block">Reset password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
