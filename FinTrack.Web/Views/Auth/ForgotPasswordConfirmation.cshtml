@{
    ViewData["Title"] = "Check your email";
}

<div class="ft-state">
    <div class="ft-empty-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" /></svg>
    </div>
    <h1>Check your email</h1>
    <p>If an account exists for that address, we've sent a link to reset your password. The link expires in 24 hours.</p>
    <a asp-action="Login" class="ft-btn ft-btn-primary">Back to sign in</a>
</div>
